/* ============================================================
   SHARED COMPONENT LOADER
   ============================================================ */

async function loadSharedComponent(containerId, fileName){

    const container = document.getElementById(containerId);

    if(!container) return;

    try{

        const componentURL =
            new URL(fileName, window.location.href);

        const response = await fetch(
            componentURL.href,
            {
                method:"GET",
                cache:"no-store"
            }
        );

        if(!response.ok){
            throw new Error(
                fileName + " HTTP " + response.status
            );
        }

        const html = await response.text();

        const parser = new DOMParser();

        const doc = parser.parseFromString(
            html,
            "text/html"
        );

        /*
         * Load stylesheet links from component into HEAD.
         */
        doc.querySelectorAll(
            'link[rel="stylesheet"], link[rel="preload"], link[rel="icon"]'
        ).forEach(oldLink => {

            const href = oldLink.getAttribute("href");

            if(!href) return;

            const absoluteHref =
                new URL(
                    href,
                    componentURL.href
                ).href;

            const exists =
                Array.from(
                    document.querySelectorAll("link")
                ).some(link => link.href === absoluteHref);

            if(!exists){

                const link =
                    document.createElement("link");

                Array.from(oldLink.attributes).forEach(attr=>{
                    link.setAttribute(
                        attr.name,
                        attr.value
                    );
                });

                link.href = absoluteHref;

                document.head.appendChild(link);
            }
        });

        /*
         * Load style blocks.
         */
        doc.querySelectorAll("style").forEach(oldStyle=>{

            const style =
                document.createElement("style");

            style.textContent =
                oldStyle.textContent;

            document.head.appendChild(style);
        });

        /*
         * Insert body HTML, excluding scripts.
         */
        container.innerHTML = "";

        Array.from(doc.body.childNodes).forEach(node=>{

            if(
                node.nodeType === Node.ELEMENT_NODE &&
                node.tagName.toLowerCase() === "script"
            ){
                return;
            }

            container.appendChild(
                document.importNode(node,true)
            );
        });

        /*
         * Fix relative images.
         */
        container.querySelectorAll("[src]").forEach(el=>{

            const src = el.getAttribute("src");

            if(
                src &&
                !/^(https?:|data:|blob:|\/)/i.test(src)
            ){
                el.src =
                    new URL(
                        src,
                        componentURL.href
                    ).href;
            }
        });

        /*
         * Fix relative links.
         */
        container.querySelectorAll("[href]").forEach(el=>{

            const href = el.getAttribute("href");

            if(
                href &&
                !/^(https?:|mailto:|tel:|#|\/)/i.test(href)
            ){
                el.href =
                    new URL(
                        href,
                        componentURL.href
                    ).href;
            }
        });

        /*
         * Execute scripts from header/footer.
         */
        doc.querySelectorAll("script").forEach(oldScript=>{

            const script =
                document.createElement("script");

            Array.from(oldScript.attributes).forEach(attr=>{

                if(attr.name.toLowerCase() === "src"){

                    script.src =
                        new URL(
                            attr.value,
                            componentURL.href
                        ).href;

                }else{

                    script.setAttribute(
                        attr.name,
                        attr.value
                    );
                }
            });

            if(!oldScript.src){
                script.textContent =
                    oldScript.textContent;
            }

            document.body.appendChild(script);
        });

        /*
         * Initialize Bootstrap mobile navbar + login dropdown
         * after header.html has actually been inserted.
         */
        if(containerId === "header-container"){
            initSharedHeaderBootstrap();
        }

        /*
         * Let shared header know which page is active.
         */
        if(containerId === "header-container"){

            const current =
                location.pathname
                    .split("/")
                    .pop()
                    .toLowerCase();

            container.querySelectorAll("a").forEach(link=>{

                const href =
                    link.getAttribute("href");

                if(!href) return;

                const page =
                    href
                    .split("/")
                    .pop()
                    .split("?")[0]
                    .split("#")[0]
                    .toLowerCase();

                if(page && page === current){
                    link.classList.add("active");
                }
            });
        }

        container.dataset.loaded = "true";

        console.log(fileName + " loaded successfully.");

    }catch(error){

        console.error(
            "Failed to load " + fileName,
            error
        );

        /*
         * Keep page usable even if component fails.
         * No raw bullet navigation is displayed.
         */
        container.innerHTML = "";
    }
}



/* ============================================================
   SHARED HEADER BOOTSTRAP INITIALIZER
   ============================================================ */

function initSharedHeaderBootstrap(){

    const navbar =
        document.querySelector("#header-container .navbar-collapse");

    const toggler =
        document.querySelector("#header-container .navbar-toggler");

    /*
     * Normal Bootstrap 5 operation.
     */
    if(
        window.bootstrap &&
        navbar &&
        toggler
    ){

        try{

            bootstrap.Collapse.getOrCreateInstance(
                navbar,
                {
                    toggle:false
                }
            );

        }catch(error){

            console.warn(
                "Bootstrap navbar initialization:",
                error
            );
        }

    }

    /*
     * Guaranteed fallback for the mobile menu.
     * If Bootstrap is delayed/blocked, the hamburger still works.
     */
    if(
        toggler &&
        !toggler.dataset.mobileMenuBound
    ){

        toggler.dataset.mobileMenuBound = "true";

        toggler.addEventListener(
            "click",
            function(event){

                /*
                 * If Bootstrap is handling it, let Bootstrap do the job.
                 */
                if(window.bootstrap){
                    return;
                }

                event.preventDefault();

                const isOpen =
                    navbar.classList.contains("show");

                if(isOpen){

                    navbar.classList.remove("show");
                    toggler.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                }else{

                    navbar.classList.add("show");
                    toggler.setAttribute(
                        "aria-expanded",
                        "true"
                    );
                }
            }
        );
    }

    /*
     * Login dropdown fallback if Bootstrap is unavailable.
     */
    const loginButton =
        document.querySelector(
            "#header-container .login-btn-btn"
        );

    const loginMenu =
        document.querySelector(
            "#header-container .dropdown-menu"
        );

    if(
        loginButton &&
        loginMenu &&
        !loginButton.dataset.dropdownBound
    ){

        loginButton.dataset.dropdownBound = "true";

        loginButton.addEventListener(
            "click",
            function(event){

                if(window.bootstrap){
                    return;
                }

                event.preventDefault();

                loginMenu.classList.toggle("show");

                loginButton.setAttribute(
                    "aria-expanded",
                    loginMenu.classList.contains("show")
                        ? "true"
                        : "false"
                );
            }
        );
    }
}

