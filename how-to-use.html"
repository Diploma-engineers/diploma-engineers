<button class="top" id="topButton" aria-label="Back to top"><i class="fa-solid fa-arrow-up"></i></button>
<script>
(function(){
const input=document.getElementById('searchInput'),count=document.getElementById('count'),empty=document.getElementById('empty');
const sections=[...document.querySelectorAll('.searchable')];
function search(){
 const q=input.value.trim().toLowerCase();let visible=0;
 sections.forEach(el=>{const hit=!q||el.innerText.toLowerCase().includes(q);el.classList.toggle('hidden',!hit);if(hit)visible++;});
 document.querySelectorAll('#faqItems details').forEach(d=>{if(q&&!d.innerText.toLowerCase().includes(q))d.open=false;});
 count.textContent=q?visible+' matching sections':'Search topics';
}
input.addEventListener('input',search);
document.getElementById('year').textContent=new Date().getFullYear();
const topButton=document.getElementById('topButton');
window.addEventListener('scroll',()=>topButton.classList.toggle('show',window.scrollY>350),{passive:true});
topButton.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
const links=[...document.querySelectorAll('.side a')];
if('IntersectionObserver' in window){const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)links.forEach(a=>a.classList.toggle('active',a.hash==='#'+e.target.id));}),{rootMargin:'-15% 0px -70% 0px'});links.forEach(a=>{const el=document.querySelector(a.hash);if(el)obs.observe(el);});}
})();
</script>
