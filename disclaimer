      <div class="contact-actions">
        <a class="contact-btn" href="https://diplomaengineers.vercel.app/" target="_blank" rel="noopener">
          <i class="fa-solid fa-globe"></i> Website
        </a>
        <a class="contact-btn" href="https://t.me/diploma_engineers7" target="_blank" rel="noopener">
          <i class="fa-brands fa-telegram"></i> Telegram
