
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Disclaimer | Diploma Engineers</title>
  <meta name="description" content="Disclaimer for Diploma Engineers - educational content, study materials, career guidance, jobs and third-party links.">
  <meta name="theme-color" content="#2563eb">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    :root{
      --blue:#2563eb;
      --blue2:#0ea5e9;
      --dark:#0f172a;
      --text:#334155;
      --muted:#64748b;
      --bg:#f6faff;
      --card:#ffffff;
      --border:#dbeafe;
      --shadow:0 16px 45px rgba(15,23,42,.08);
      --radius:22px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:"Plus Jakarta Sans",sans-serif;
      background:
        radial-gradient(circle at 10% 10%,rgba(37,99,235,.09),transparent 28%),
        radial-gradient(circle at 90% 20%,rgba(14,165,233,.09),transparent 28%),
        var(--bg);
      color:var(--text);
      overflow-x:hidden;
    }

    a{text-decoration:none;color:inherit}

    /* Only fetched shared components */
    #header-slot{min-height:58px}
    #footer-slot{margin-top:24px}

    .page-wrap{
      width:min(1180px,calc(100% - 28px));
      margin:20px auto 0;
    }

    .hero{
      position:relative;
      overflow:hidden;
      background:linear-gradient(135deg,#0b63f6,#0ea5e9);
      border-radius:28px;
      padding:38px 28px;
      color:#fff;
      box-shadow:0 18px 50px rgba(37,99,235,.20);
      margin-bottom:18px;
    }
    .hero:before,
    .hero:after{
      content:"";
      position:absolute;
      border-radius:50%;
      background:rgba(255,255,255,.12);
      pointer-events:none;
    }
    .hero:before{width:220px;height:220px;right:-70px;top:-110px}
    .hero:after{width:150px;height:150px;left:-55px;bottom:-85px}

    .hero-inner{
      position:relative;
      z-index:2;
      max-width:820px;
      margin:auto;
      text-align:center;
    }

    .hero-badge{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 14px;
      border-radius:999px;
      background:rgba(255,255,255,.16);
      border:1px solid rgba(255,255,255,.3);
      font-size:12px;
      font-weight:800;
      margin-bottom:14px;
      backdrop-filter:blur(8px);
    }

    .hero h1{
      margin:0;
      font-size:clamp(30px,6vw,52px);
      line-height:1.05;
      font-weight:800;
      letter-spacing:-1.5px;
    }

    .hero h1 span{color:#ffd166}

    .hero p{
      margin:14px auto 0;
      max-width:700px;
      color:rgba(255,255,255,.92);
      line-height:1.7;
      font-size:14px;
    }

    .date-bar{
      margin-top:22px;
      display:flex;
      justify-content:center;
      align-items:center;
      flex-wrap:wrap;
      gap:10px;
      font-size:12px;
      font-weight:700;
    }
    .date-pill{
      background:#fff;
      color:#1d4ed8;
      padding:9px 13px;
      border-radius:999px;
      box-shadow:0 8px 25px rgba(15,23,42,.10);
    }

    .notice{
      display:flex;
      gap:14px;
      align-items:flex-start;
      padding:18px;
      background:#fff7db;
      border:1px solid #fde68a;
      border-left:5px solid #f59e0b;
      border-radius:18px;
      margin-bottom:18px;
      box-shadow:0 8px 28px rgba(245,158,11,.08);
    }
    .notice i{
      width:40px;
      height:40px;
      flex:0 0 40px;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#f59e0b;
      color:#fff;
    }
    .notice h3{margin:0 0 4px;font-size:15px;color:#92400e}
    .notice p{margin:0;font-size:12px;line-height:1.6;color:#78350f}

    .section-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:16px;
    }

    .card{
      background:rgba(255,255,255,.94);
      border:1px solid var(--border);
      border-radius:var(--radius);
      padding:22px;
      box-shadow:var(--shadow);
    }

    .card.full{grid-column:1/-1}

    .icon{
      width:48px;
      height:48px;
      display:flex;
      align-items:center;
      justify-content:center;
      border-radius:15px;
      background:linear-gradient(135deg,#dbeafe,#e0f2fe);
      color:#1d4ed8;
      font-size:20px;
      margin-bottom:14px;
    }

    .card h2{
      margin:0 0 8px;
      color:var(--dark);
      font-size:18px;
      line-height:1.3;
      letter-spacing:-.3px;
    }

    .card p,
    .card li{
      color:var(--text);
      font-size:13px;
      line-height:1.75;
    }

    .card p{margin:0}
    .card ul{margin:8px 0 0;padding-left:18px}
    .card li{margin:4px 0}

    .highlight{
      margin-top:12px;
      padding:12px 14px;
      border-radius:13px;
      background:#eff6ff;
      border:1px solid #bfdbfe;
      color:#1e40af;
      font-size:12px;
      line-height:1.6;
      font-weight:600;
    }

    .contact{
      background:linear-gradient(135deg,#eff6ff,#ecfeff);
      border:1px solid #bfdbfe;
      border-radius:24px;
      padding:24px;
      margin-top:16px;
      box-shadow:var(--shadow);
    }
    .contact h2{
      margin:0 0 8px;
      color:var(--dark);
      font-size:20px;
    }
    .contact p{
      margin:0 0 16px;
      font-size:13px;
      line-height:1.7;
      color:var(--muted);
    }

    .contact-actions{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
    }
    .contact-btn{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:11px 14px;
      background:#fff;
      border:1px solid #bfdbfe;
      border-radius:12px;
      color:#1d4ed8;
      font-size:12px;
      font-weight:800;
      transition:.18s ease;
    }
    .contact-btn:hover{transform:translateY(-2px);box-shadow:0 10px 20px rgba(37,99,235,.10)}

    .trust{
      margin-top:16px;
      padding:20px;
      border-radius:22px;
      background:#0f172a;
      color:#fff;
      text-align:center;
      box-shadow:0 18px 45px rgba(15,23,42,.18);
    }
    .trust i{font-size:28px;color:#60a5fa;margin-bottom:8px}
    .trust h3{margin:0 0 5px;font-size:18px}
    .trust p{margin:0;color:#cbd5e1;font-size:12px;line-height:1.6}

    .top-btn{
      position:fixed;
      right:16px;
      bottom:18px;
      width:45px;
      height:45px;
      border:0;
      border-radius:50%;
      background:var(--blue);
      color:#fff;
      cursor:pointer;
      box-shadow:0 10px 25px rgba(37,99,235,.30);
      display:none;
      z-index:999;
    }

    .loading{
      max-width:1180px;
      width:calc(100% - 28px);
      margin:16px auto;
      padding:18px;
      border-radius:16px;
      background:#fff;
      border:1px solid var(--border);
      color:var(--muted);
      font-size:13px;
      text-align:center;
    }

    .load-error{
      background:#fff1f2;
      border-color:#fecdd3;
      color:#9f1239;
    }

    @media(max-width:760px){
      .section-grid{grid-template-columns:1fr}
      .card.full{grid-column:auto}
      .page-wrap{width:min(100% - 18px,1180px)}
      .hero{padding:30px 18px;border-radius:22px}
      .card{padding:18px;border-radius:18px}
      .notice{padding:15px}
    }
  </style>
</head>

<body>

  <!-- HEADER FETCH ONLY -->
  <div id="header-slot">
    <div class="loading">Loading header...</div>
  </div>

  <main class="page-wrap">

    <section class="hero">
      <div class="hero-inner">
        <div class="hero-badge">
