<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Refund Policy | Diploma Engineers</title>
<meta name="description" content="Refund Policy for Diploma Engineers. All payments made for courses, digital study materials and services are non-refundable.">
<meta name="theme-color" content="#2563eb">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
:root{
  --blue:#2563eb;
  --blue2:#0ea5e9;
  --dark:#0f172a;
  --text:#334155;
  --muted:#64748b;
  --bg:#f6faff;
  --card:#fff;
  --border:#dbeafe;
  --red:#dc2626;
  --red-bg:#fff1f2;
  --red-border:#fecdd3;
  --shadow:0 16px 45px rgba(15,23,42,.08);
  --radius:22px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  font-family:"Plus Jakarta Sans",sans-serif;
  color:var(--text);
  background:
    radial-gradient(circle at 8% 8%,rgba(37,99,235,.08),transparent 27%),
    radial-gradient(circle at 92% 18%,rgba(14,165,233,.08),transparent 28%),
    var(--bg);
  overflow-x:hidden;
}
a{text-decoration:none;color:inherit}
#header-slot{min-height:58px}
#footer-slot{margin-top:24px}

.container{
  width:min(1180px,calc(100% - 28px));
  margin:20px auto 0;
}

.hero{
  position:relative;
  overflow:hidden;
  background:linear-gradient(135deg,#0b63f6,#0ea5e9);
  border-radius:28px;
  padding:40px 24px;
  color:#fff;
  box-shadow:0 18px 50px rgba(37,99,235,.20);
  text-align:center;
}
.hero:before,.hero:after{
  content:"";
  position:absolute;
  border-radius:50%;
  background:rgba(255,255,255,.12);
}
.hero:before{width:230px;height:230px;right:-75px;top:-120px}
.hero:after{width:165px;height:165px;left:-70px;bottom:-95px}
.hero-content{position:relative;z-index:2;max-width:800px;margin:auto}
.badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:8px 14px;
  border-radius:999px;
  background:rgba(255,255,255,.16);
  border:1px solid rgba(255,255,255,.3);
  backdrop-filter:blur(8px);
  font-size:12px;
  font-weight:800;
}
.hero h1{
  margin:15px 0 10px;
  font-size:clamp(30px,6vw,52px);
  line-height:1.05;
  font-weight:800;
  letter-spacing:-1.4px;
}
.hero h1 span{color:#ffd166}
.hero p{
  margin:0 auto;
  max-width:700px;
  color:rgba(255,255,255,.92);
  font-size:14px;
  line-height:1.7;
}
.date{
  margin-top:20px;
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:#fff;
  color:#1d4ed8;
  padding:9px 13px;
  border-radius:999px;
  font-size:12px;
  font-weight:800;
  box-shadow:0 8px 25px rgba(15,23,42,.10);
}

.no-refund{
  margin-top:18px;
  background:linear-gradient(135deg,#fff1f2,#fff7f7);
  border:2px solid #fda4af;
  border-radius:24px;
  padding:25px;
  box-shadow:0 14px 40px rgba(220,38,38,.10);
  text-align:center;
}
.no-refund-icon{
  width:66px;height:66px;margin:0 auto 13px;
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:#dc2626;color:#fff;font-size:27px;
  box-shadow:0 10px 25px rgba(220,38,38,.25);
}
.no-refund h2{
  margin:0 0 7px;
  color:#991b1b;
  font-size:25px;
}
.no-refund p{
  margin:0 auto;
  max-width:780px;
  font-size:13px;
  line-height:1.75;
  color:#7f1d1d;
}

.grid{
  margin-top:16px;
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:16px;
}
.card{
  background:rgba(255,255,255,.95);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:22px;
  box-shadow:var(--shadow);
}
.card.full{grid-column:1/-1}
.icon{
  width:48px;height:48px;
  display:flex;align-items:center;justify-content:center;
  border-radius:15px;
  background:linear-gradient(135deg,#dbeafe,#e0f2fe);
  color:#1d4ed8;
  font-size:20px;
  margin-bottom:14px;
}
.card h2{
  margin:0 0 8px;
  color:var(--dark);
  font-size:18px;
}
.card p,.card li{
  font-size:13px;
  line-height:1.75;
}
.card p{margin:0}
.card ul{margin:8px 0 0;padding-left:18px}
.card li{margin:4px 0}
.highlight{
  margin-top:12px;
  padding:12px 14px;
  border-radius:13px;
  background:#eff6ff;
  border:1px solid #bfdbfe;
  color:#1e40af;
  font-size:12px;
  line-height:1.6;
  font-weight:700;
}

.contact{
  margin-top:16px;
  background:linear-gradient(135deg,#eff6ff,#ecfeff);
  border:1px solid #bfdbfe;
  border-radius:24px;
  padding:24px;
  box-shadow:var(--shadow);
}
.contact h2{margin:0 0 8px;font-size:20px;color:var(--dark)}
.contact p{margin:0 0 15px;font-size:13px;line-height:1.7;color:var(--muted)}
.links{display:flex;flex-wrap:wrap;gap:10px}
.link{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:11px 14px;
  background:#fff;
  border:1px solid #bfdbfe;
  border-radius:12px;
  color:#1d4ed8;
  font-size:12px;
  font-weight:800;
}

.trust{
  margin-top:16px;
  padding:20px;
  border-radius:22px;
  background:#0f172a;
  color:#fff;
  text-align:center;
}
.trust i{font-size:28px;color:#60a5fa;margin-bottom:8px}
.trust h3{margin:0 0 5px;font-size:18px}
.trust p{margin:0;color:#cbd5e1;font-size:12px;line-height:1.6}

.top{
  position:fixed;
  right:16px;
  bottom:18px;
  width:45px;height:45px;
  border:0;border-radius:50%;
  background:var(--blue);
  color:#fff;
  cursor:pointer;
  box-shadow:0 10px 25px rgba(37,99,235,.30);
  display:none;
  z-index:999;
}
.loading{
  max-width:1180px;
  width:calc(100% - 28px);
  margin:16px auto;
  padding:18px;
  border-radius:16px;
  background:#fff;
  border:1px solid var(--border);
  color:var(--muted);
  font-size:13px;
  text-align:center;
}
.error{
  background:#fff1f2;
  border-color:#fecdd3;
  color:#9f1239;
}

@media(max-width:760px){
  .container{width:min(100% - 18px,1180px)}
  .grid{grid-template-columns:1fr}
  .card.full{grid-column:auto}
  .hero{padding:30px 18px;border-radius:22px}
  .card{padding:18px;border-radius:18px}
  .no-refund{padding:20px}
}
</style>
</head>

<body>

<!-- ONLY header.html is fetched -->
<div id="header-slot">
  <div class="loading">Loading header...</div>
</div>

<main class="container">

  <section class="hero">
    <div class="hero-content">
      <div class="badge">
        <i class="fa-solid fa-receipt"></i>
        Diploma Engineers • Refund Policy
      </div>

      <h1>Refund <span>Policy</span></h1>

      <p>
        Please read this policy carefully before purchasing any course,
        digital study material, subscription or other paid service from
        Diploma Engineers.
      </p>

      <div class="date">
        <i class="fa-regular fa-calendar"></i>
        Last Updated: 16 August 2026
      </div>
    </div>
  </section>

  <section class="no-refund">
    <div class="no-refund-icon">
      <i class="fa-solid fa-ban"></i>
    </div>
    <h2>No Refund</h2>
    <p>
      <strong>All payments made to Diploma Engineers are non-refundable.</strong>
      Once a payment has been successfully completed for a course, digital
      content, study material, subscription or other service, the amount
      cannot be refunded, returned or reversed, except where required by
      applicable law or expressly approved by Diploma Engineers.
    </p>
  </section>

  <section class="grid">

    <article class="card full">
      <div class="icon"><i class="fa-solid fa-circle-info"></i></div>
      <h2>1. General Refund Policy</h2>
      <p>
        Diploma Engineers follows a strict no-refund policy for paid digital
        products and services. Because digital content may become available
        immediately after successful payment, users should review the course,
        service and purchase details carefully before completing a transaction.
      </p>
    </article>

    <article class="card">
      <div class="icon"><i class="fa-solid fa-graduation-cap"></i></div>
      <h2>2. Courses & Digital Content</h2>
      <p>
        Payments for online courses, video lectures, notes, e-books, PDFs,
        premium study resources and other digital educational materials are
        non-refundable once the order has been processed or access has been
        provided.
      </p>
    </article>

    <article class="card">
      <div class="icon"><i class="fa-solid fa-credit-card"></i></div>
      <h2>3. Successful Payments</h2>
      <p>
        A successful payment confirms your purchase. After successful payment,
        cancellation or refund requests will normally not be accepted.
      </p>
      <div class="highlight">
        Please check the selected course or service before making payment.
      </div>
    </article>

    <article class="card">
      <div class="icon"><i class="fa-solid fa-user-xmark"></i></div>
      <h2>4. Change of Mind</h2>
      <p>
        Refunds are not provided because of a change of mind, lack of use,
        failure to attend classes, failure to download content, or personal
        reasons after purchase.
      </p>
    </article>

    <article class="card">
      <div class="icon"><i class="fa-solid fa-wifi"></i></div>
      <h2>5. Device & Internet Issues</h2>
      <p>
        Refunds will not normally be issued because of internet connectivity,
        device compatibility, browser problems, operating system issues or
        other technical conditions on the user's side.
      </p>
    </article>

    <article class="card">
      <div class="icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
      <h2>6. Duplicate or Technical Payment</h2>
      <p>
        If you believe that a technical issue caused a duplicate charge or
        an incorrect payment, contact us with the transaction details.
        Such cases may be reviewed individually and are not an automatic
        entitlement to a refund.
      </p>
    </article>

    <article class="card">
      <div class="icon"><i class="fa-solid fa-building-columns"></i></div>
      <h2>7. Payment Gateway Issues</h2>
      <p>
        If money is debited from your account but the payment status does not
        reach Diploma Engineers successfully, the transaction may require
        verification with the payment gateway or bank. Any reversal or
        settlement will depend on the payment provider's process.
      </p>
    </article>

    <article class="card full">
      <div class="icon"><i class="fa-solid fa-scale-balanced"></i></div>
      <h2>8. Exceptions</h2>
      <p>
        Diploma Engineers may consider an exception only where required by
        applicable law, a proven duplicate transaction, an accidental charge
        that is verified by the payment records, or another situation
        expressly approved by the management. Approval of one exception does
        not create a general refund right.
      </p>
    </article>

    <article class="card">
      <div class="icon"><i class="fa-solid fa-headset"></i></div>
      <h2>9. Contact Before Purchase</h2>
      <p>
        Please contact us before purchasing if you have questions about a
        course, digital product, access, features or payment terms. We
        encourage users to clarify their questions before making payment.
      </p>
    </article>

    <article class="card">
      <div class="icon"><i class="fa-solid fa-rotate"></i></div>
      <h2>10. Policy Changes</h2>
      <p>
        Diploma Engineers may update this Refund Policy from time to time.
        Any changes will be published on this page with an updated date.
      </p>
    </article>

  </section>

  <section class="contact">
    <h2><i class="fa-solid fa-envelope"></i> Contact Us</h2>
    <p>
      For payment verification or transaction-related questions, contact
      Diploma Engineers through the official channels below and provide
      your transaction/order details where applicable.
    </p>

    <div class="links">
      <a class="link" href="https://diplomaengineers.vercel.app/" target="_blank" rel="noopener">
        <i class="fa-solid fa-globe"></i> Website
      </a>
      <a class="link" href="https://t.me/diploma_engineers7" target="_blank" rel="noopener">
        <i class="fa-brands fa-telegram"></i> Telegram
      </a>
      <a class="link" href="https://whatsapp.com/channel/0029Vay8k8CAojYkBQWr1s1w" target="_blank" rel="noopener">
        <i class="fa-brands fa-whatsapp"></i> WhatsApp
      </a>
    </div>
  </section>

  <section class="trust">
    <i class="fa-solid fa-shield-halved"></i>
    <h3>Please Review Before Payment</h3>
    <p>
      By completing a purchase, you acknowledge and accept this
      no-refund policy.
    </p>
  </section>

</main>

<!-- ONLY footer.html is fetched -->
<div id="footer-slot">
  <div class="loading">Loading footer...</div>
</div>

<button class="top" id="topBtn" aria-label="Back to top">
  <i class="fa-solid fa-arrow-up"></i>
</button>

<script>
  /*
    ONLY header.html and footer.html are fetched.
    Keep these three files in the same folder:
      header.html
      footer.html
      refundpolicy.html
  */

  async function fetchShared(file, targetId, name){
    const target = document.getElementById(targetId);

    try{
      const response = await fetch(file, {
        method:"GET",
        cache:"no-cache"
      });

      if(!response.ok){
        throw new Error(file + " returned " + response.status);
      }

      const html = await response.text();

      if(!html.trim()){
        throw new Error(file + " is empty");
      }

      target.innerHTML = html;
    }catch(err){
      console.error(name + " fetch error:", err);
      target.innerHTML = `
        <div class="loading error">
          Unable to load ${name}. Please make sure
          <b>${file}</b> exists in the same folder.
        </div>
      `;
    }
  }

  function runFetchedScripts(){
    ["header-slot","footer-slot"].forEach(id=>{
      const root=document.getElementById(id);
      if(!root) return;

      root.querySelectorAll("script").forEach(oldScript=>{
        const newScript=document.createElement("script");

        [...oldScript.attributes].forEach(attr=>{
          newScript.setAttribute(attr.name,attr.value);
        });

        if(oldScript.src){
          newScript.src=oldScript.src;
        }else{
          newScript.textContent=oldScript.textContent;
        }

        oldScript.replaceWith(newScript);
      });
    });
  }

  async function loadSharedLayout(){
    await Promise.all([
      fetchShared("header.html","header-slot","header"),
      fetchShared("footer.html","footer-slot","footer")
    ]);

    runFetchedScripts();
  }

  const topBtn=document.getElementById("topBtn");

  window.addEventListener("scroll",()=>{
    topBtn.style.display = window.scrollY > 400 ? "flex" : "none";
    if(window.scrollY > 400){
      topBtn.style.alignItems="center";
      topBtn.style.justifyContent="center";
    }
  },{passive:true});

  topBtn.addEventListener("click",()=>{
    window.scrollTo({top:0,behavior:"smooth"});
  });

  loadSharedLayout();
</script>

</body>
</html>
