<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Result Portal - Diploma Engineers</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    padding:0;
    font-family:'Poppins',sans-serif;
    background:#ffffff;
    color:#111827;
    overflow-x:hidden;
}

/* ===============================
   HEADER
================================ */

#header{
    width:100%;
    position:relative;
    z-index:9999;
}

/* ===============================
   PAGE BACKGROUND
================================ */

.result-page{
    position:relative;
    min-height:100vh;
    overflow:hidden;
    background:
        radial-gradient(circle at 10% 10%,rgba(37,99,235,.07),transparent 30%),
        radial-gradient(circle at 90% 20%,rgba(124,58,237,.07),transparent 30%),
        #ffffff;
}

/* ===============================
   FLOATING STICKERS
================================ */

.sticker{
    position:absolute;
    z-index:1;

    display:flex;
    align-items:center;
    gap:9px;

    padding:10px 15px;

    background:rgba(255,255,255,.9);
    border:1px solid #e5e7eb;

    border-radius:50px;

    box-shadow:
        0 10px 30px rgba(15,23,42,.08);

    font-size:11px;
    font-weight:600;

    color:#475467;

    animation:floatSticker 4s ease-in-out infinite;
}

.sticker i{
    font-size:16px;
}

.sticker-one{
    top:120px;
    left:5%;
    color:#2563eb;
}

.sticker-two{
    top:190px;
    right:5%;
    color:#7c3aed;
    animation-delay:1s;
}

.sticker-three{
    bottom:180px;
    left:7%;
    color:#16a34a;
    animation-delay:2s;
}

.sticker-four{
    bottom:130px;
    right:7%;
    color:#f97316;
    animation-delay:3s;
}

@keyframes floatSticker{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-12px);
    }

}

/* ===============================
   HERO
================================ */

.result-hero{
    position:relative;
    z-index:2;

    text-align:center;

    padding:
        90px 20px
        55px;

    border-bottom:1px solid #eef0f3;
}

.badge-top{
    display:inline-flex;
    align-items:center;
    gap:8px;

    padding:8px 15px;

    border-radius:50px;

    background:#ffffff;
    border:1px solid #e5e7eb;

    box-shadow:0 6px 20px rgba(0,0,0,.04);

    font-size:10px;
    font-weight:700;

    color:#667085;

    animation:slideDown .7s ease;
}

.badge-top i{
    color:#16a34a;
}

.result-hero h1{
    margin:18px 0 10px;

    font-size:
        clamp(35px,6vw,62px);

    font-weight:800;

    letter-spacing:-2.5px;

    line-height:1.08;

    animation:slideUp .8s ease;
}

.result-hero h1 span{
    background:
        linear-gradient(
            90deg,
            #111827,
            #2563eb,
            #7c3aed
        );

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;
}

.result-hero p{
    max-width:650px;

    margin:0 auto;

    color:#667085;

    font-size:13px;

    line-height:1.8;

    animation:slideUp 1s ease;
}

@keyframes slideDown{

    from{
        opacity:0;
        transform:translateY(-20px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

@keyframes slideUp{

    from{
        opacity:0;
        transform:translateY(25px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

/* ===============================
   RESULT CONTAINER
================================ */

.result-container{

    position:relative;
    z-index:3;

    width:min(1180px,calc(100% - 24px));

    margin:
        0 auto
        70px;

    animation:
        resultContainerIn
        .8s
        .2s
        ease both;
}

@keyframes resultContainerIn{

    from{
        opacity:0;
        transform:translateY(35px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

/* ===============================
   RESULT CARD
================================ */

.result-card{

    background:#ffffff;

    border:
        1px solid #e4e7ec;

    border-radius:28px;

    overflow:hidden;

    box-shadow:
        0 25px 70px
        rgba(15,23,42,.08);

}

/* ===============================
   CARD TOP BAR
================================ */

.result-card-header{

    min-height:65px;

    padding:
        10px 18px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:15px;

    background:#ffffff;

    border-bottom:
        1px solid #eef0f3;
}

.result-heading{

    display:flex;

    align-items:center;

    gap:11px;
}

.result-icon{

    width:40px;
    height:40px;

    display:flex;

    align-items:center;
    justify-content:center;

    border-radius:13px;

    background:#f5f8ff;

    color:#2563eb;

    border:1px solid #e5e7eb;
}

.result-heading strong{

    display:block;

    font-size:13px;

    font-weight:800;

}

.result-heading small{

    display:block;

    margin-top:2px;

    color:#98a2b3;

    font-size:9px;

}

/* ===============================
   REFRESH BUTTON
================================ */

.refresh-result{

    border:1px solid #e4e7ec;

    background:#ffffff;

    color:#475467;

    padding:8px 12px;

    border-radius:11px;

    font-family:inherit;

    font-size:10px;

    font-weight:700;

    cursor:pointer;

    transition:.25s ease;
}

.refresh-result:hover{

    background:#111827;

    color:#ffffff;

    border-color:#111827;

}

.refresh-result i{

    margin-right:5px;

}

/* ===============================
   LOADER
================================ */

#resultLoader{

    min-height:400px;

    display:flex;

    flex-direction:column;

    align-items:center;
    justify-content:center;

    gap:15px;

    color:#667085;

    font-size:12px;

}

.loader{

    width:45px;
    height:45px;

    border-radius:50%;

    border:
        3px solid #e5e7eb;

    border-top-color:#2563eb;

    border-right-color:#7c3aed;

    animation:
        rotate .7s linear infinite;
}

@keyframes rotate{

    to{
        transform:rotate(360deg);
    }

}

/* ===============================
   RESULT CONTENT
================================ */

#resultContent{

    width:100%;

    position:relative;

    background:#ffffff;

}

/*
   result.html body ke content
   ko clean container ke andar rakhega
*/

#resultContent > *{
    max-width:100%;
}

/* ===============================
   ERROR
================================ */

.result-error{

    display:none;

    min-height:350px;

    padding:50px 20px;

    text-align:center;
}

.result-error-icon{

    width:65px;
    height:65px;

    margin:0 auto 18px;

    display:flex;

    align-items:center;
    justify-content:center;

    border-radius:20px;

    background:#fef2f2;

    color:#ef4444;

    font-size:25px;
}

.result-error h3{

    margin-bottom:7px;

    font-size:20px;

    font-weight:800;
}

.result-error p{

    color:#667085;

    font-size:12px;
}

/* ===============================
   BOTTOM INFO
================================ */

.portal-info{

    margin-top:22px;

    display:flex;

    justify-content:center;

    flex-wrap:wrap;

    gap:9px;
}

.info-pill{

    display:flex;

    align-items:center;

    gap:7px;

    padding:8px 13px;

    background:#ffffff;

    border:1px solid #e4e7ec;

    border-radius:50px;

    box-shadow:
        0 5px 18px rgba(15,23,42,.04);

    color:#667085;

    font-size:10px;

    font-weight:600;
}

.info-pill i{

    color:#16a34a;

}

/* ===============================
   MOBILE
================================ */

@media(max-width:768px){

    .result-hero{

        padding:
            75px 15px
            40px;

    }

    .result-hero h1{

        font-size:38px;

        letter-spacing:-1.8px;

    }

    .result-hero p{

        font-size:11px;

    }

    .sticker{

        display:none;

    }

    .result-container{

        width:
            calc(100% - 14px);

        margin-bottom:45px;

    }

    .result-card{

        border-radius:20px;

    }

    .result-card-header{

        padding:
            9px 11px;

    }

    .result-heading strong{

        font-size:11px;

    }

    .refresh-result{

        padding:
            7px 9px;

    }

    .refresh-result span{

        display:none;

    }

}

@media(max-width:400px){

    .result-hero h1{

        font-size:32px;

    }

    .result-hero{

        padding-top:65px;

    }

}


/* ===============================
   REDUCED MOTION
================================ */

@media(prefers-reduced-motion:reduce){

    *,
    *::before,
    *::after{

        animation-duration:.01ms !important;

        animation-iteration-count:1 !important;

        transition-duration:.01ms !important;

    }

}

</style>

</head>


<body>


<!-- =====================================================
     HEADER FETCH
====================================================== -->

<div id="header"></div>


<!-- =====================================================
     MAIN RESULT PAGE
====================================================== -->

<main class="result-page">


    <!-- FLOATING STICKERS -->

    <div class="sticker sticker-one">

        <i class="fa-solid fa-graduation-cap"></i>

        Diploma Results

    </div>


    <div class="sticker sticker-two">

        <i class="fa-solid fa-bolt"></i>

        Fast Portal

    </div>


    <div class="sticker sticker-three">

        <i class="fa-solid fa-circle-check"></i>

        Easy Access

    </div>


    <div class="sticker sticker-four">

        <i class="fa-solid fa-mobile-screen"></i>

        Mobile Friendly

    </div>


    <!-- =================================================
         HERO
    ================================================== -->

    <section class="result-hero">

        <div class="badge-top">

            <i class="fa-solid fa-shield-halved"></i>

            DIPLOMA ENGINEERS RESULT PORTAL

        </div>


        <h1>

            Check Your

            <span>Result</span>

        </h1>


        <p>

            Your complete result search portal is available
            below. Search your Diploma result directly
            without leaving this page.

        </p>

    </section>



    <!-- =================================================
         RESULT CONTAINER
    ================================================== -->

    <section class="result-container">


        <div class="result-card">


            <!-- CARD HEADER -->

            <div class="result-card-header">


                <div class="result-heading">

                    <div class="result-icon">

                        <i class="fa-solid fa-file-circle-check"></i>

                    </div>


                    <div>

                        <strong>
                            Result Search Portal
                        </strong>

                        <small>
                            Official result interface
                        </small>

                    </div>

                </div>


                <button
                    class="refresh-result"
                    onclick="loadResult()"
                >

                    <i class="fa-solid fa-rotate"></i>

                    <span>
                        Refresh
                    </span>

                </button>


            </div>



            <!-- =================================================
                 LOADER
            ================================================== -->

            <div id="resultLoader">

                <div class="loader"></div>

                <div>
                    Loading Result Portal...
                </div>

            </div>



            <!-- =================================================
                 RESULT HTML WILL BE FETCHED HERE
            ================================================== -->

            <div id="resultContent"></div>



            <!-- =================================================
                 ERROR
            ================================================== -->

            <div
                class="result-error"
                id="resultError"
            >

                <div class="result-error-icon">

                    <i class="fa-solid fa-triangle-exclamation"></i>

                </div>


                <h3>
                    Result Portal Could Not Load
                </h3>


                <p id="errorText">

                    Please make sure
                    <b>result.html</b>
                    exists in the same folder.

                </p>

            </div>


        </div>



        <!-- INFO PILLS -->

        <div class="portal-info">

            <div class="info-pill">

                <i class="fa-solid fa-bolt"></i>

                Fast Search

            </div>


            <div class="info-pill">

                <i class="fa-solid fa-mobile-screen"></i>

                Mobile Friendly

            </div>


            <div class="info-pill">

                <i class="fa-solid fa-circle-check"></i>

                Easy Result Access

            </div>

        </div>


    </section>


</main>


<!-- =====================================================
     FOOTER FETCH
====================================================== -->

<div id="footer"></div>



<script>

/* =====================================================
   FETCH HEADER
===================================================== */

async function loadHeader(){

    const header=
        document.getElementById("header");

    if(!header) return;

    try{

        const response=
            await fetch(
                "header.html",
                {
                    cache:"no-cache"
                }
            );

        if(!response.ok){

            throw new Error(
                "header.html not found"
            );

        }

        header.innerHTML=
            await response.text();

    }
    catch(error){

        console.error(
            "Header Error:",
            error
        );

    }

}


/* =====================================================
   FETCH FOOTER
===================================================== */

async function loadFooter(){

    const footer=
        document.getElementById("footer");

    if(!footer) return;

    try{

        const response=
            await fetch(
                "footer.html",
                {
                    cache:"no-cache"
                }
            );

        if(!response.ok){

            throw new Error(
                "footer.html not found"
            );

        }

        footer.innerHTML=
            await response.text();

    }
    catch(error){

        console.error(
            "Footer Error:",
            error
        );

    }

}


/* =====================================================
   FETCH RESULT.HTML
===================================================== */

async function loadResult(){

    const loader=
        document.getElementById(
            "resultLoader"
        );

    const content=
        document.getElementById(
            "resultContent"
        );

    const error=
        document.getElementById(
            "resultError"
        );

    const errorText=
        document.getElementById(
            "errorText"
        );


    /* reset */

    loader.style.display="flex";

    content.style.display="none";

    error.style.display="none";


    try{

        /*
         * Fetch your existing result.html
         */

        const response=
            await fetch(
                "result.html",
                {
                    method:"GET",
                    cache:"no-cache"
                }
            );


        if(!response.ok){

            throw new Error(
                "result.html not found"
            );

        }


        /*
         * Get complete HTML
         */

        const html=
            await response.text();


        /*
         * Parse result.html
         */

        const parser=
            new DOMParser();

        const doc=
            parser.parseFromString(
                html,
                "text/html"
            );


        /*
         * Copy styles from result.html
         */

        const styles=
            doc.querySelectorAll(
                "style"
            );


        styles.forEach(
            style=>{

                const newStyle=
                    document.createElement(
                        "style"
                    );

                newStyle.textContent=
                    style.textContent;

                newStyle.dataset.resultStyle=
                    "true";

                document.head.appendChild(
                    newStyle
                );

            }
        );


        /*
         * Copy external CSS
         */

        const links=
            doc.querySelectorAll(
                'link[rel="stylesheet"]'
            );


        links.forEach(
            link=>{

                const href=
                    link.getAttribute(
                        "href"
                    );

                if(!href) return;


                const exists=
                    document.querySelector(
                        `link[data-result-css="${href}"]`
                    );


                if(!exists){

                    const newLink=
                        document.createElement(
                            "link"
                        );

                    newLink.rel=
                        "stylesheet";

                    newLink.href=
                        href;

                    newLink.dataset.resultCss=
                        href;

                    document.head.appendChild(
                        newLink
                    );

                }

            }
        );


        /*
         * Get BODY content
         */

        const bodyContent=
            doc.body
                ? doc.body.innerHTML
                : html;


        /*
         * Put result.html body
         * inside this page
         */

        content.innerHTML=
            bodyContent;


        /*
         * Remove duplicate body/html tags
         * if they somehow appear.
         */

        content
            .querySelectorAll(
                "html,body"
            )
            .forEach(
                element=>{
                    element.remove();
                }
            );


        loader.style.display=
            "none";

        error.style.display=
            "none";

        content.style.display=
            "block";


        /*
         * Execute scripts from
         * result.html
         */

        const scripts=
            doc.querySelectorAll(
                "script"
            );


        scripts.forEach(
            oldScript=>{

                const newScript=
                    document.createElement(
                        "script"
                    );


                /*
                 * External JS
                 */

                if(oldScript.src){

                    newScript.src=
                        oldScript.src;

                }
                else{

                    newScript.textContent=
                        oldScript.textContent;

                }


                /*
                 * Copy attributes
                 */

                for(
                    const attribute
                    of oldScript.attributes
                ){

                    if(
                        attribute.name !==
                        "src"
                    ){

                        newScript.setAttribute(
                            attribute.name,
                            attribute.value
                        );

                    }

                }


                document.body.appendChild(
                    newScript
                );

            }
        );


        /*
         * Smooth reveal
         */

        requestAnimationFrame(
            ()=>{
                content.classList.add(
                    "result-loaded"
                );
            }
        );


    }
    catch(err){

        console.error(
            "Result Fetch Error:",
            err
        );


        loader.style.display=
            "none";

        content.style.display=
            "none";

        error.style.display=
            "block";


        errorText.innerHTML=
            `
            ${err.message}<br><br>
            Please check that
            <b>result.html</b>
            is available in the same folder.
            `;

    }

}


/* =====================================================
   PAGE START
===================================================== */

document.addEventListener(
    "DOMContentLoaded",
    async function(){

        /*
         * Header + Footer simultaneously
         */

        await Promise.all([
            loadHeader(),
            loadFooter()
        ]);


        /*
         * Then load existing result portal
         */

        await loadResult();

    }
);


/* =====================================================
   PREVENT HORIZONTAL OVERFLOW
===================================================== */

window.addEventListener(
    "resize",
    function(){

        document.body.style.overflowX=
            "hidden";

    }
);

</script>


</body>
</html>
