async function loadSharedComponent(id, file){
  const el=document.getElementById(id);
  if(!el) return;
  try{
    const response=await fetch(file,{cache:'no-cache'});
    if(!response.ok) throw new Error(file+' returned '+response.status);
    const html=await response.text();
    if(!html.trim()) throw new Error(file+' is empty');
    el.innerHTML=html;
  }catch(error){
    console.warn('Shared component fallback:',file,error);
    el.innerHTML=id==='header'?fallbackHeader():fallbackFooter();
  }
}

document.addEventListener('DOMContentLoaded',()=>{
  loadSharedComponent('header','header.html');
  loadSharedComponent('footer','footer.html');
});
