<script>
async function fetchShared(file,targetId,name){
  const target=document.getElementById(targetId);
  try{
    const response=await fetch(file,{method:"GET",cache:"no-cache"});
    if(!response.ok) throw new Error(file+" returned "+response.status);
    const html=await response.text();
    if(!html.trim()) throw new Error(file+" is empty");
    target.innerHTML=html;
  }catch(err){
    console.error(name+" fetch error:",err);
    target.innerHTML=`
      <div class="loading error">
        Unable to load ${name}. Please make sure <b>${file}</b> exists in the same folder.
      </div>`;
  }
}

function runFetchedScripts(){
  ["header-slot","footer-slot"].forEach(id=>{
    const root=document.getElementById(id);
    if(!root)return;
    root.querySelectorAll("script").forEach(oldScript=>{
      const newScript=document.createElement("script");
      [...oldScript.attributes].forEach(attr=>newScript.setAttribute(attr.name,attr.value));
      if(oldScript.src)newScript.src=oldScript.src;
      else newScript.textContent=oldScript.textContent;
      oldScript.replaceWith(newScript);
    });
  });
}

async function loadSharedLayout(){
  await Promise.all([
    fetchShared("header.html","header-slot","header"),
    fetchShared("footer.html","footer-slot","footer")
  ]);
  runFetchedScripts();
}

const topBtn=document.getElementById("topBtn");
window.addEventListener("scroll",()=>{
  topBtn.style.display=window.scrollY>400?"flex":"none";
  if(window.scrollY>400){
    topBtn.style.alignItems="center";
    topBtn.style.justifyContent="center";
  }
},{passive:true});
topBtn.addEventListener("click",()=>window.scrollTo({top:0,behavior:"smooth"}));

loadSharedLayout();
</script>

