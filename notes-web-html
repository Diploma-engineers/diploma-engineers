
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Semester Courses | Diploma Engineers</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>

        /* =========================================
           RESET
        ========================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f6f8fc;
            color: #1d2433;
            overflow-x: hidden;
        }


        /* =========================================
           SCROLL PROGRESS BAR
        ========================================== */

        #scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            width: 0%;
            height: 4px;
            background: linear-gradient(
                90deg,
                #2563eb,
                #7c3aed,
                #06b6d4
            );
            z-index: 999999;
            transition: width 0.1s linear;
        }


        /* =========================================
           MAIN PAGE
        ========================================== */

        .courses-page {
            min-height: 100vh;
            padding: 45px 20px 70px;
        }

        .container {
            width: 100%;
            max-width: 1250px;
            margin: auto;
        }


        /* =========================================
           HERO SECTION
        ========================================== */

        .page-heading {
            text-align: center;
            margin-bottom: 35px;
        }

        .page-heading .badge {
            display: inline-block;
            padding: 8px 18px;
            background: #e8efff;
            color: #2563eb;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .page-heading h1 {
            font-size: clamp(28px, 5vw, 42px);
            font-weight: 800;
            margin-bottom: 10px;
            color: #172033;
        }

        .page-heading h1 span {
            color: #2563eb;
        }

        .page-heading p {
            max-width: 650px;
            margin: auto;
            color: #6b7280;
            font-size: 15px;
            line-height: 1.7;
        }


        /* =========================================
           SEARCH + FILTER
        ========================================== */

        .course-controls {
            display: flex;
            gap: 15px;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 40px;
        }

        .search-box {
            position: relative;
            flex: 1;
            min-width: 250px;
        }

        .search-box input {
            width: 100%;
            border: none;
            outline: none;
            background: #ffffff;
            padding: 16px 20px 16px 50px;
            border-radius: 14px;
            font-family: inherit;
            font-size: 14px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
            border: 1px solid #edf0f5;
            transition: 0.3s ease;
        }

        .search-box input:focus {
            border-color: #2563eb;
            box-shadow: 0 8px 30px rgba(37,99,235,0.12);
        }

        .search-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 20px;
            color: #64748b;
            z-index: 2;
        }

        .filter-buttons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .filter-btn {
            border: none;
            padding: 12px 18px;
            border-radius: 10px;
            background: #ffffff;
            color: #555;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid #e9edf3;
            transition: 0.3s ease;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
            transform: translateY(-2px);
        }


        /* =========================================
           SEMESTER SECTION
        ========================================== */

        .semester-section {
            margin-bottom: 60px;
        }

        .semester-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 25px;
        }

        .semester-title-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .semester-number {
            width: 50px;
            height: 50px;
            min-width: 50px;
            border-radius: 15px;
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(37,99,235,0.25);
        }

        .semester-title h2 {
            font-size: 24px;
            font-weight: 700;
            color: #172033;
        }

        .semester-title p {
            color: #7b8494;
            font-size: 13px;
            margin-top: 3px;
        }

        .course-count {
            background: #eef3ff;
            color: #2563eb;
            padding: 8px 14px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
        }


        /* =========================================
           COURSE GRID
        ========================================== */

        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 22px;
        }


        /* =========================================
           COURSE CARD
        ========================================== */

        .course-card {
            position: relative;
            background: #ffffff;
            border-radius: 20px;
            padding: 24px;
            border: 1px solid #edf0f5;
            box-shadow: 0 10px 30px rgba(15,23,42,0.05);
            overflow: hidden;

            /* Scroll Animation Initial State */
            opacity: 0;
            transform: translateY(45px) scale(0.97);

            transition:
                opacity 0.65s ease,
                transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.3s ease;
        }

        .course-card.show {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .course-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(
                90deg,
                #2563eb,
                #7c3aed
            );
            transform: scaleX(0);
            transform-origin: left;
            transition: 0.35s ease;
        }

        .course-card:hover {
            transform: translateY(-8px) scale(1.01);
            box-shadow: 0 20px 45px rgba(15,23,42,0.12);
        }

        .course-card:hover::before {
            transform: scaleX(1);
        }


        /* =========================================
           COURSE CARD CONTENT
        ========================================== */

        .course-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 22px;
        }

        .course-icon {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            background: #eef4ff;
            transition: 0.3s ease;
        }

        .course-card:hover .course-icon {
            transform: rotate(8deg) scale(1.08);
        }

        .semester-tag {
            background: #f4f6f9;
            color: #6b7280;
            font-size: 11px;
            font-weight: 600;
            padding: 7px 10px;
            border-radius: 8px;
        }

        .course-card h3 {
            font-size: 17px;
            line-height: 1.5;
            font-weight: 700;
            color: #1d2433;
            min-height: 52px;
            margin-bottom: 8px;
        }

        .course-card p {
            color: #7a8393;
            font-size: 12px;
            line-height: 1.7;
            margin-bottom: 20px;
            min-height: 40px;
        }


        /* =========================================
           OPEN COURSE BUTTON
        ========================================== */

        .open-course-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            background: #172033;
            color: #ffffff;
            padding: 13px 15px;
            border-radius: 11px;
            font-size: 13px;
            font-weight: 600;
            transition: 0.3s ease;
        }

        .open-course-btn:hover {
            background: #2563eb;
            transform: scale(1.02);
        }


        /* =========================================
           SCROLL REVEAL ANIMATION
        ========================================== */

        .scroll-reveal {
            opacity: 0;
            transform: translateY(50px);
            transition:
                opacity 0.8s ease,
                transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .scroll-reveal.show {
            opacity: 1;
            transform: translateY(0);
        }


        /* =========================================
           LEFT REVEAL
        ========================================== */

        .scroll-left {
            opacity: 0;
            transform: translateX(-60px);
            transition:
                opacity 0.8s ease,
                transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .scroll-left.show {
            opacity: 1;
            transform: translateX(0);
        }


        /* =========================================
           NO RESULT
        ========================================== */

        .no-result {
            display: none;
            text-align: center;
            padding: 60px 20px;
            color: #777;
        }

        .no-result h3 {
            margin-bottom: 8px;
            color: #333;
        }


        /* =========================================
           RESPONSIVE
        ========================================== */

        @media (max-width: 768px) {

            .courses-page {
                padding: 30px 15px 50px;
            }

            .course-controls {
                flex-direction: column;
                align-items: stretch;
            }

            .filter-buttons {
                width: 100%;
