  </main>

  <!-- FOOTER FETCH ONLY -->
  <div id="footer-slot">
    <div class="loading">Loading footer...</div>
  </div>

  <button class="top-btn" id="topBtn" aria-label="Back to top">
    <i class="fa-solid fa-arrow-up"></i>
  </button>

  <script>
    /*
      ONLY header.html and footer.html are fetched.
      Keep all three files in the same directory:
      header.html
      footer.html
      disclaimer.html
    */

    async function fetchSharedComponent(file, targetId, label){
      const target = document.getElementById(targetId);

      try{
        const response = await fetch(file, {
          method: "GET",
          cache: "no-cache"
        });

        if(!response.ok){
          throw new Error(file + " returned " + response.status);
        }

        const html = await response.text();

        if(!html.trim()){
          throw new Error(file + " is empty");
        }

        target.innerHTML = html;
      }catch(error){
        console.error(label + " load error:", error);

        target.innerHTML = `
          <div class="loading load-error">
            Unable to load ${label}.
            Please make sure <b>${file}</b> exists in the same folder.
          </div>
        `;
      }
    }

    function syncHeaderFooterScripts(){
      /*
        If header/footer use inline scripts, scripts inside fetched HTML
        may not execute automatically. Re-run only scripts from the
        fetched header/footer fragments.
      */
      ["header-slot","footer-slot"].forEach(slotId => {
        const slot = document.getElementById(slotId);
        if(!slot) return;

        slot.querySelectorAll("script").forEach(oldScript => {
          const newScript = document.createElement("script");

          [...oldScript.attributes].forEach(attr => {
            newScript.setAttribute(attr.name, attr.value);
          });

          if(oldScript.src){
            newScript.src = oldScript.src;
          }else{
            newScript.textContent = oldScript.textContent;
          }

          oldScript.replaceWith(newScript);
        });
      });
    }

    async function loadSharedLayout(){
      await Promise.all([
        fetchSharedComponent("header.html", "header-slot", "header"),
        fetchSharedComponent("footer.html", "footer-slot", "footer")
      ]);

      syncHeaderFooterScripts();
    }

    const topBtn = document.getElementById("topBtn");

    window.addEventListener("scroll", () => {
      if(window.scrollY > 400){
        topBtn.style.display = "flex";
        topBtn.style.alignItems = "center";
        topBtn.style.justifyContent = "center";
      }else{
        topBtn.style.display = "none";
      }
    }, {passive:true});

    topBtn.addEventListener("click", () => {
      window.scrollTo({top:0, behavior:"smooth"});
    });

    loadSharedLayout();
  </script>

</body>
</html>
