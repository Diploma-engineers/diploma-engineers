                gap: 16px;
            }

            .course-card {
                padding: 20px;
            }

        }


        @media (max-width: 400px) {

            .page-heading h1 {
                font-size: 26px;
            }

            .filter-buttons {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


