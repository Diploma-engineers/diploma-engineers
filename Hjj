const EMAIL_ENDPOINT =
    "https://formsubmit.co/ajax/astar22072006@gmail.com";

const HOME_URL =
    "https://diplomaengineers.vercel.app/";


/* ============================================================
   DOM READY
   ============================================================ */

document.addEventListener("DOMContentLoaded",function(){

    /*
     * Load shared header and footer.
     */
    loadSharedComponent(
        "header-container",
        "header.html"
    );

    loadSharedComponent(
        "footer-container",
        "footer.html"
    );


    const form =
        document.getElementById("campusAdminForm");

    const submitBtn =
        document.getElementById("submitBtn");

    const status =
        document.getElementById("formStatus");

    const photo =
        document.getElementById("profilePhoto");

    const previewImg =
        document.getElementById("previewImg");

    const photoIcon =
        document.getElementById("photoIcon");


    /* ========================================================
       PHOTO PREVIEW + VALIDATION
       ======================================================== */

    photo.addEventListener("change",function(){

        const file = this.files[0];

        if(!file) return;

        const allowed = [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];

        if(!allowed.includes(file.type)){

            this.value = "";

            showError(
                "Please upload JPG, PNG or WebP image only."
            );

            return;
        }

        if(file.size > 2 * 1024 * 1024){

            this.value = "";

            showError(
                "Profile photo must be smaller than 2 MB."
            );

            return;
        }

        const reader =
            new FileReader();

        reader.onload = function(e){

            previewImg.src =
                e.target.result;

            previewImg.style.display =
                "block";

            photoIcon.style.display =
                "none";
        };

        reader.readAsDataURL(file);
    });


    /* ========================================================
       MOBILE NUMBER
       ======================================================== */

    document
        .getElementById("mobile")
        .addEventListener("input",function(){

            this.value =
                this.value
                    .replace(/\D/g,"")
                    .slice(0,10);
        });


    /* ========================================================
       STATUS HELPERS
       ======================================================== */

    function showError(message){

        status.className =
            "form-status error";

        status.textContent =
            message;

        status.scrollIntoView({
            behavior:"smooth",
            block:"center"
        });
    }

    function clearStatus(){

        status.className =
            "form-status";

        status.textContent = "";
    }


    /* ========================================================
       CLOUDINARY PROFILE PHOTO UPLOAD
       Photo is uploaded first and its permanent secure_url is
       then included in the application email.
       ======================================================== */

    const CLOUDINARY_CLOUD_NAME = "ub0qgzwa";
    const CLOUDINARY_UPLOAD_PRESET = "news_upload";

    function uploadProfilePhotoToCloudinary(file){
        return new Promise((resolve,reject)=>{
            const xhr = new XMLHttpRequest();
            const url = `https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD_NAME}/image/upload`;

            xhr.open("POST", url, true);

            xhr.upload.onprogress = function(event){
                if(event.lengthComputable){
                    const percent = Math.round((event.loaded / event.total) * 100);
                    submitBtn.textContent = `Uploading Photo ${percent}%`;
                }
            };

            xhr.onload = function(){
                try{
                    const result = JSON.parse(xhr.responseText);
                    if(xhr.status >= 200 && xhr.status < 300 && result.secure_url){
                        resolve(result);
                    }else{
                        reject(new Error(result?.error?.message || "Cloudinary upload failed."));
                    }
                }catch(error){
                    reject(new Error("Invalid Cloudinary response."));
                }
            };

            xhr.onerror = function(){
                reject(new Error("Network error while uploading photo."));
            };

            const uploadData = new FormData();
            uploadData.append("file", file);
            uploadData.append("upload_preset", CLOUDINARY_UPLOAD_PRESET);
            uploadData.append("folder", "diploma-engineers/campus-admin");

            xhr.send(uploadData);
        });
    }

    /* ========================================================
       SUBMIT
       ======================================================== */

    form.addEventListener("submit",async function(event){

        event.preventDefault();

        clearStatus();

        /*
         * Browser validation.
         */
        if(!form.checkValidity()){

            form.reportValidity();

            return;
        }

        /*
         * Mobile validation.
         */
        const mobile =
            document
            .getElementById("mobile")
            .value
            .trim();

        if(!/^[6-9]\d{9}$/.test(mobile)){

            showError(
                "Please enter a valid Indian 10-digit mobile number."
            );

            return;
        }

        /*
         * At least one skill.
         */
        const skills =
            Array.from(
                document.querySelectorAll(
                    'input[name="Skills"]:checked'
                )
            );

        if(skills.length === 0){

            showError(
                "Please select at least one strongest skill."
            );

            return;
        }

        /*
         * Photo validation again before sending.
         */
        const file =
            photo.files[0];

        if(file){

            if(file.size > 2 * 1024 * 1024){

                showError(
                    "Profile photo must be smaller than 2 MB."
                );

                return;
            }

            if(
                ![
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ].includes(file.type)
            ){

                showError(
                    "Please upload JPG, PNG or WebP image only."
                );

                return;
            }
        }

        /*
         * Prevent double submit.
         */
        submitBtn.disabled = true;

        submitBtn.textContent =
            "Submitting...";

        try{

            let photoUrl = "";

            /* Upload photo to Cloudinary before sending email. */
            if(file){
                submitBtn.textContent = "Uploading Photo...";
                const cloudinaryResult = await uploadProfilePhotoToCloudinary(file);
                photoUrl = cloudinaryResult.secure_url;
            }

            submitBtn.textContent = "Sending Application...";

            const data =
                new FormData(form);

            /* The original file is not relied upon for email delivery.
               The permanent Cloudinary URL is sent instead. */
            data.delete("Profile Photo");
            data.append(
                "Profile Photo URL",
                photoUrl || "No profile photo uploaded"
            );
            data.append(
                "Photo Link",
                photoUrl || "No profile photo uploaded"
            );

            /*
             * FormSubmit settings.
             */
            data.append(
                "_subject",
                "New Campus Admin Application | Diploma Engineers"
            );

            data.append(
                "_captcha",
                "false"
            );

            data.append(
                "_template",
                "table"
            );

            data.append(
                "_replyto",
                document.getElementById("email").value.trim()
            );

            /*
             * Explicit skills string.
             */
            data.append(
                "Selected Skills",
                skills
                    .map(item=>item.value)
                    .join(", ")
            );


            const response =
                await fetch(
                    EMAIL_ENDPOINT,
                    {
                        method:"POST",
                        body:data,
                        headers:{
                            "Accept":"application/json"
                        }
                    }
                );


            let result = {};

            try{
                result = await response.json();
            }catch(e){
                result = {};
            }


            if(
                !response.ok ||
                result.success === false
            ){
                throw new Error(
                    result.message ||
                    "Application could not be submitted."
                );
            }


            /*
             * SUCCESS
             */
            document
                .getElementById("successOverlay")
                .style.display = "flex";

            /*
             * Reset form after successful submit.
             */
            form.reset();

            previewImg.style.display =
                "none";

            photoIcon.style.display =
                "block";


            /*
             * Return home after 3 seconds.
             */
            setTimeout(function(){

                window.location.href =
                    HOME_URL;

            },3000);


        }catch(error){

            console.error(error);

            showError(
                "Unable to submit your application right now. Please try again."
            );

            submitBtn.disabled = false;

            submitBtn.textContent =
                "Submit Application 🚀";
        }

    });

});
</script>


